# ---------- General ----------
NODE_ENV=development
# true en la demo pública: reinicia datos cada noche, bloquea cambios al admin y manda correos a Mailpit
DEMO_MODE=false

# ---------- Backend ----------
PORT=4000
# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
# Nivel de pino: trace | debug | info | warn | error
LOG_LEVEL=debug

# ---------- Base de datos ----------
POSTGRES_USER=reservaya
POSTGRES_PASSWORD=reservaya
POSTGRES_DB=reservaya
DATABASE_URL=postgresql://reservaya:reservaya@localhost:5432/reservaya
# Base separada que usan las pruebas de integración
DATABASE_URL_TEST=postgresql://reservaya:reservaya@localhost:5432/reservaya_test

# ---------- Autenticación ----------
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Segundos en que un refresh token recién rotado sigue aceptándose (pestañas múltiples)
REFRESH_GRACE_SECONDS=30

# ---------- Correo ----------
# Usar IP, no "localhost": Nodemailer lo resuelve por DNS y puede colgarse
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="ReservaYa <no-responder@reservaya.demo>"
# URL pública del frontend, usada en los enlaces de los correos
APP_URL=http://localhost:5173

# ---------- Frontend (Vite solo expone variables con prefijo VITE_) ----------
VITE_API_URL=http://localhost:4000/api


# ---------- Producción (docker-compose.prod.yml) ----------
# Prefijo de las imágenes publicadas en GHCR (vacío → se construyen en local)
IMAGE_PREFIX=ghcr.io/tu-usuario/reservaya
IMAGE_TAG=latest
# Dominio para HTTPS automático con Caddy; http://localhost para probar sin TLS
DOMAIN=http://localhost
# Perfiles de compose que usa el despliegue (--profile demo activa Mailpit en /mailpit)
COMPOSE_PROFILES=

# ---------- Vercel Cron ----------
# Si está definido, habilita GET /api/jobs/reminders y /api/jobs/demo-reset (Authorization: Bearer <secreto>)
# Vercel lo envía automáticamente en sus crons si la variable se llama CRON_SECRET
CRON_SECRET=
