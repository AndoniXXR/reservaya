# ---------- General ----------
NODE_ENV=development
# true en la demo pública: reinicia datos cada noche, bloquea cambios al admin y manda correos a Mailpit
DEMO_MODE=false

# ---------- Backend ----------
PORT=4000
# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
# Nivel de pino: trace | debug | info | warn | error
LOG_LEVEL=debug

# ---------- Base de datos ----------
POSTGRES_USER=reservaya
POSTGRES_PASSWORD=reservaya
POSTGRES_DB=reservaya
DATABASE_URL=postgresql://reservaya:reservaya@localhost:5432/reservaya
# Base separada que usan las pruebas de integración
DATABASE_URL_TEST=postgresql://reservaya:reservaya@localhost:5432/reservaya_test

# ---------- Autenticación ----------
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Segundos en que un refresh token recién rotado sigue aceptándose (pestañas múltiples)
REFRESH_GRACE_SECONDS=30

# ---------- Correo ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="ReservaYa <no-responder@reservaya.demo>"
# URL pública del frontend, usada en los enlaces de los correos
APP_URL=http://localhost:5173

# ---------- Frontend (Vite solo expone variables con prefijo VITE_) ----------
VITE_API_URL=http://localhost:4000/api

